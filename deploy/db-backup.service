[Unit]
Description=MySQL 全量备份（WebDAV）
After=network-online.target mysqld.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/yunwei
ExecStart=/opt/yunwei/venv/bin/python /opt/yunwei/db_backup.py
EnvironmentFile=/opt/yunwei/.env
StandardOutput=append:/var/log/db_backup.log
StandardError=append:/var/log/db_backuperr.log

# 安全加固
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/yunwei /tmp
ReadOnlyPaths=/etc/mysql
